# ---- Bite & Brew server configuration ----
# development | demo | test | production
APP_ENV=development
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgresql://bitebrew:bitebrew_dev@localhost:5432/bitebrew_dev
# Origin(s) of the web app, comma separated (used for CORS / WebSocket origin checks)
WEB_ORIGIN=http://localhost:5173
# Session lifetime in hours (one long shift)
SESSION_TTL_HOURS=12
# Set to true behind HTTPS (required in production)
COOKIE_SECURE=false
# Trust X-Forwarded-For from a reverse proxy (number of hops), 0 = none
TRUST_PROXY=0
LOG_LEVEL=info
